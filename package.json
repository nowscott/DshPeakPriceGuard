{
  "name": "dsh-peak-price-guard",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: asks before sending during DeepSeek peak (non-discount) hours, with holiday data that follows the State Council notices.",
  "license": "MIT",
  "author": "nowscott",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowscott/DshPeakPriceGuard.git"
  },
  "homepage": "https://github.com/nowscott/DshPeakPriceGuard#readme",
  "bugs": {
    "url": "https://github.com/nowscott/DshPeakPriceGuard/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "verifiedAgainst": "0.2.2-rc.1"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/peak.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "pricing",
    "peak-hours",
    "cost-guard",
    "chinese-holidays"
  ]
}
